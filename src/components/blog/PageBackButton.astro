---
import { ChevronLeft } from 'lucide-astro';

interface Props {
  href: string;
}

const { href } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const fallbackHref = `${basePath}${href.startsWith('/') ? href : `/${href}`}`;
---

<a
  class="page-back-button"
  href={fallbackHref}
  aria-label="Back to the previous page"
  title="Back"
  data-page-back
>
  <ChevronLeft size={18} strokeWidth={2.15} aria-hidden="true" />
  <span>Back</span>
</a>

<script>
  const initPageBackButtons = () => {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-page-back]')) {
      if (link.dataset.backReady) continue;

      link.dataset.backReady = 'true';
      link.addEventListener('click', (event) => {
        if (
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey
        ) {
          return;
        }

        const referrer = document.referrer;
        const cameFromThisSite = referrer && new URL(referrer).origin === window.location.origin;

        if (cameFromThisSite && window.history.length > 1) {
          event.preventDefault();
          window.history.back();
        }
      });
    }
  };

  initPageBackButtons();
  document.addEventListener('astro:page-load', initPageBackButtons);
</script>

<style>
  .page-back-button {
    position: relative;
    z-index: 1;
    display: inline-flex;
    gap: 6px;
    align-items: center;
    justify-content: center;
    width: fit-content;
    min-height: 38px;
    padding: 7px 11px 7px 9px;
    border: 1px solid color-mix(in srgb, var(--paper-line-strong) 78%, white 22%);
    border-radius: 12px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.36), transparent), var(--paper-control);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.54),
      0 3px 10px rgba(31, 35, 40, 0.035);
    color: var(--paper-ink-soft);
    font-family: var(--font-ui-label);
    font-size: 0.86rem;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    transition:
      transform 180ms ease,
      border-color 180ms ease,
      background 180ms ease,
      box-shadow 180ms ease,
      color 180ms ease;
  }

  .page-back-button:hover {
    border-color: color-mix(in srgb, var(--paper-accent) 30%, var(--paper-line-strong));
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.46), transparent), var(--paper-control-hover);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.64),
      0 6px 16px rgba(31, 35, 40, 0.06);
    color: var(--paper-accent);
    transform: translateX(-2px);
  }

  .page-back-button:focus-visible {
    outline: 2px solid var(--paper-accent);
    outline-offset: 3px;
  }

  :global(:root[data-theme='dark']) .page-back-button {
    border-color: var(--paper-line-strong);
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.055), transparent), var(--paper-control);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 4px 12px rgba(0, 0, 0, 0.14);
  }

  @media (max-width: 720px) {
    .page-back-button {
      width: 36px;
      min-height: 36px;
      padding: 0;
      border-radius: 10px;
    }

    .page-back-button span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
  }
</style>
